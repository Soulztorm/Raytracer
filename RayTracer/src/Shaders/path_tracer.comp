// GGX Importance Sampling
vec3 sampleGGX(vec3 N, float roughness, inout uint randomSeed) {
    float r1 = RandomValue(randomSeed); // Random number in [0,1]
    float r2 = RandomValue(randomSeed);

    float alpha = roughness * roughness; // Convert roughness to alpha
    float theta = atan(sqrt((alpha * alpha * r1) / (1.0 - r1))); // GGX theta
    float phi = 2.0 * PI * r2; // Uniform phi

    // Convert spherical coordinates to Cartesian
    vec3 H = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));

    // Transform to world space
    return toWorld(H, N);
}

vec3 sampleGGXReflection(vec3 V, vec3 N, float roughness, inout uint randomSeed) {
    vec3 H = sampleGGX(N, roughness, randomSeed);
    return reflect(-V, H); // Compute reflection
}

vec2 rotate(vec2 v, float a) {
	float s = sin(a);
	float c = cos(a);
	mat2 m = mat2(c, s, -s, c);
	return m * v;
}



vec3 hdrPixelToWorldDirection(in vec2 uv) {
    float longitude = (uv.x - 0.5) * 2.0 * PI; // Map [0,1] → [-π, π]
    float latitude  = (0.5 - uv.y) * PI;       // Map [0,1] → [π/2, -π/2]

    vec3 worldDir;
    worldDir.x = cos(latitude) * cos(longitude);
    worldDir.y = sin(latitude);
    worldDir.z = cos(latitude) * sin(longitude);

    return normalize(worldDir);
}

vec4 SampleHDRIFromDirection(in vec3 worldDir)
{
    // Apply longitude rotation (horizontal)
    worldDir.xz = rotate(worldDir.xz, camdata.skyX * PI);

    // Apply latitude rotation correctly (vertical)
    float cosLat = cos(camdata.skyY * 2.0 * PI);
    float sinLat = sin(camdata.skyY * 2.0 * PI);

    vec3 rotatedDir;
    rotatedDir.x = worldDir.x;
    rotatedDir.y = worldDir.y * cosLat - worldDir.z * sinLat;
    rotatedDir.z = worldDir.y * sinLat + worldDir.z * cosLat;

    rotatedDir = normalize(rotatedDir);

    // Compute spherical coordinates
    float longitude = atan(rotatedDir.z, rotatedDir.x);  // Ranges from -pi to pi
    float latitude = asin(rotatedDir.y);                 // Ranges from -pi/2 to pi/2

	// Convert to normalized UV coordinates
	float u = (longitude + PI) * PI1_2; // Map from [-pi, pi] to [0,1]
	float v = (0.5 * PI - latitude) * PI1;    // Map from [-pi/2, pi/2] to [0,1], flip v

	// Convert to pixel coordinates
    ivec2 pixelCoords = ivec2(u * 4096, v * 2048);
	return imageLoad(hdri_image, pixelCoords);
}





bool RefractionRay(in vec3 ray_dir_in, in vec3 normal, in vec3 intersection_point, float IOR, inout Ray ray_out)
{
	vec3 ref_n = normal;
	float eta_t = IOR;
	float eta_i = 1.0f;
	float i_dot_n = dot(ray_dir_in, normal);

	if (i_dot_n < 0.0f) {
		i_dot_n = -i_dot_n;
	}
	else {
		//Inside the surface; invert the normal and swap the indices of refraction
		ref_n = -normal;
		eta_t = 1.0f;
		eta_i = IOR;
	}

	float eta = eta_i / eta_t;
	float k = 1.0f - (eta * eta) * (1.0f - i_dot_n * i_dot_n);
	if (k < 0.0f) {
		return false;
	}
	else {
		ray_out.Origin = intersection_point + (ref_n * -FLT_EPSILON);
		ray_out.Direction = normalize((ray_dir_in + i_dot_n * ref_n) * eta - ref_n * sqrt(k));
		return true;
	}
}

float FresnelReflectAmount (float n1, float n2, vec3 normal, vec3 incident)
{
        // Schlick aproximation
        float r0 = (n1-n2) / (n1+n2);
        r0 *= r0;
        float cosX = -dot(normal, incident);
        if (n1 > n2)
        {
            float n = n1/n2;
            float sinT2 = n*n*(1.0-cosX*cosX);
            // Total internal reflection
            if (sinT2 > 1.0)
                return 1.0;
            cosX = sqrt(1.0-sinT2);
        }
        float x = 1.0-cosX;
        float ret = r0+(1.0-r0)*x*x*x*x*x;
 
        // adjust reflect multiplier for object reflectivity
        ret = (0.5 + (1.0-0.5) * ret);
        return ret;
}


vec3 sampleSunDisk(float sunAngularRadius, inout uint randomSeed) {
    vec2 diskSample = RandomInCircle(randomSeed) * sunAngularRadius;
    
    // Create tangent space
    vec3 up = abs(sunDir.y) < 0.999 ? vec3(0,1,0) : vec3(1,0,0);
    vec3 right = normalize(cross(up, sunDir));
    vec3 forward = cross(sunDir, right);

    // Rotate sun direction by sampled offset
    return normalize(sunDir + right * diskSample.x + forward * diskSample.y);
}


vec3 sampleDirectLight(HitInfo hitInfo, float sunAngularRadius, inout uint randomSeed) {
    vec3 lightDir = sampleSunDisk(sunAngularRadius, randomSeed);

    Ray sunTestRay;
    sunTestRay.Origin = hitInfo.position + lightDir * FLT_EPSILON;
    sunTestRay.Direction = lightDir;

    HitInfo hitSun = IntersectRay(sunTestRay);
    bool sunVisible = hitSun.materialIndex < 0;

    // Check if light is visible (shadow ray)
    if (sunVisible) {
        // Compute BSDF probability
        float p_bsdf = pdfBSDF(lightDir, hitInfo.normal);
        vec3 sunLight = p_bsdf * SampleHDRIFromDirection(lightDir).rgb;
        return sunLight;
    } 

    return vec3(0.0); // No contribution if occluded
}


