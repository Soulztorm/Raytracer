void main() {
    uint randomSeed = camdata.frameindex * uint(image_width * image_height) + gl_GlobalInvocationID.x;
    vec2 uv = vec2((gl_GlobalInvocationID.x % uint(image_width)) / image_width, (gl_GlobalInvocationID.x / image_width) / image_height); 
    vec2 uvCentered = uv * 2.f - 1.f;

    vec3 finalColor = vec3(0.0);
    
    
    vec3 directLight = vec3(0.0);
    
    vec3 contribution = vec3(1.0);
    float pdfContribution = 1.0f;

    //sunDir = hdrPixelToWorldDirection(camdata.hdriSunUV);

    // Apply longitude rotation (horizontal)
    sunDir.xz = rotate(sunDir.xz, -camdata.skyX * PI);

    //Apply latitude rotation correctly (vertical)
    float cosLat = cos(-camdata.skyY * 2.0 * PI);
    float sinLat = sin(-camdata.skyY * 2.0 * PI);

    vec3 rotatedDir;
    rotatedDir.x = sunDir.x;
    rotatedDir.y = sunDir.y * cosLat - sunDir.z * sinLat;
    rotatedDir.z = sunDir.y * sinLat + sunDir.z * cosLat;
    sunDir = normalize(rotatedDir);
    sunDirInverse = 1.0 / sunDir;



    Ray ray;

    // Defocus ray origin
	vec2 camJitter = RandomInCircle(randomSeed) * camdata.dofStrength;
	ray.Origin = camdata.camPos.xyz + camdata.camRight.xyz * camJitter.x + camdata.camUp.xyz * camJitter.y;

	// Defocus at viewpoint, basically anti aliasing
	vec2 lookatJitter = RandomInCircle(randomSeed) * 0.01;
	vec3 lookatVector = vec3(raydirs[gl_GlobalInvocationID.x * 3], raydirs[gl_GlobalInvocationID.x * 3 + 1], raydirs[gl_GlobalInvocationID.x * 3 + 2]);
	vec3 lookatPosition = lookatVector * camdata.dofDist + camdata.camPos.xyz + camdata.camRight.xyz * lookatJitter.x + camdata.camUp.xyz * lookatJitter.y;
	ray.Direction = normalize(lookatPosition - ray.Origin);


    float lastIOR = 1.0;

    if (camdata.rendermode == 0){
        for (int i = 0; i < camdata.bounces; i++){
            // Do the actual ray test in the scene
            HitInfo hitInfo = IntersectRay(ray);

            // No hit
            if (hitInfo.materialIndex < 0){
                vec3 skyColor = SampleHDRIFromDirection(ray.Direction).rgb;
                finalColor += contribution * skyColor;
                break;
            }

            Material mat = GetMaterial(hitInfo.materialIndex);


            // Get the color for this material, either diffuse texture lookup or material albedo
            vec4 albedoColor = GetAlbedoColor(mat, hitInfo);

            // Alpha clipping, continue ray on other side (Alpha transparency in textures)
            if (albedoColor.a < 0.9){
                ray.Origin = hitInfo.position + ray.Direction * FLT_EPSILON * 2.0;
                continue;
            }


            // Direct light
            vec3 directLight = vec3(0);
            if (RandomValue(randomSeed) < 0.2){
                directLight = sampleDirectLight(hitInfo, randomSeed);          
            }


            vec3 diffuseRayDir = RandomCosineInHemisphere(hitInfo.normal, randomSeed);
            pdfContribution = pdfBSDF(diffuseRayDir, hitInfo.normal);

            // New ray origin offset from last hit position along surface normal
            ray.Origin = hitInfo.position + hitInfo.normal * FLT_EPSILON;
            ray.Direction = diffuseRayDir;

            contribution *= albedoColor.rgb;
 



            //finalColor += mat.Emission * contribution;
            finalColor += (directLight + mat.Emission.rgb) * contribution;

            contribution /= pdfContribution;


            // Russian Roulette
            // As the throughput gets smaller, the ray is more likely to get terminated early.
            // Survivors have their value boosted to make up for fewer samples being in the average.     
            float p = max(contribution.r, max(contribution.g, contribution.b));
            if (RandomValue(randomSeed) > p)
                break;

            // Add the energy we 'lose' by randomly terminating paths
            contribution *= 1.0f / p;
        }
    }
    else{
        HitInfo hitInfo = IntersectRay(ray);

        // No hit
        if (hitInfo.materialIndex < 0){
            finalColor = SampleHDRIFromDirection(ray.Direction).rgb;
        }
        else{
            // Get the color for this material, either diffuse texture lookup or material albedo
            Material mat = GetMaterial(hitInfo.materialIndex);
            finalColor = GetAlbedoColor(mat, hitInfo).rgb;
        }
    }
    
    
    vec4 oldColor = img_accu[gl_GlobalInvocationID.x];
    vec4 newColor = oldColor + ((vec4(finalColor, 1.0) - oldColor) / camdata.frameindex); 
    img_accu[gl_GlobalInvocationID.x] = newColor;

    if (camdata.frameindex % 20 == 1)
    {
        // Color corrected image
        if (camdata.useACE == 1){
            finalColor = LinearToSRGB(ACESFilm(camdata.exposure * newColor.rgb));
        }
        else{
            finalColor = camdata.exposure * newColor.rgb;
        }

        img_out[gl_GlobalInvocationID.x] = vec4(finalColor, 1.0);
    }
}