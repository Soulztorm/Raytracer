#version 450


layout (local_size_x = 1) in;

#define MAX_DEPTH 32


// Ray directions
layout(set = 0, binding = 0) readonly buffer buf_raydirs { float raydirs[]; };

// Nodes BB, index and triangle count
layout(set = 0, binding = 1) readonly buffer buf_nodes_bb { float nodes_bb[]; };
layout(set = 0, binding = 2) readonly buffer buf_nodes_index_tricount { int nodes_index_tricount[]; };
layout(set = 0, binding = 3) readonly buffer buf_tris_opt { float tris_opt[]; };
layout(set = 0, binding = 4) readonly buffer buf_tris_mats { int tris_mats[]; };

// materials
layout(set = 0, binding = 5) readonly buffer buf_mats { float mats[]; };

// Textures
layout(set = 0, binding = 6) readonly buffer buf_textures { vec4 textures[]; };
// Diffuse
layout(set = 0, binding = 7) readonly buffer buf_texturesDiffuseIndices { int textures_diffuseIdx[]; };
// Specular
layout(set = 0, binding = 8) readonly buffer buf_texturesSpecularIndices { int textures_specularIdx[]; };


// hdri
layout(rgba32f, binding = 9) readonly uniform image2D hdri_image;
layout(set = 0, binding = 10) readonly buffer buf_hdri_cdf { float hdri_cdf[]; };

// Output image
layout(set = 0, binding = 11) buffer buf_img_accu { vec4 img_accu[]; };
layout(set = 0, binding = 12) writeonly buffer buf_img_out { vec4 img_out[]; };



layout(constant_id = 0) const float image_width = 0;
layout(constant_id = 1) const float image_height = 0;
layout(constant_id = 2) const float hdri_width = 0;
layout(constant_id = 3) const float hdri_height = 0;

// Kompute supports push constants updated on dispatch
layout(push_constant) readonly uniform PushConstants {
    vec4 camPos;
    vec4 camRight;
    vec4 camUp;
    uint frameindex;
    uint rendermode;
    uint bounces;
    float exposure;
    float dofDist;
    float dofStrength;
    float skyX;
    float skyY;
    uint useACE;
    uint accumulate;
} camdata;

shared float skyDir_cl;
shared float skyDir_sl;
shared float skyDirInv_cl;
shared float skyDirInv_sl;


#include "structs.glsl"
#include "utility.glsl"
#include "brdf.glsl"
#include "intersections.glsl"



bool RefractionRay(in vec3 ray_dir_in, in vec3 normal, in vec3 intersection_point, float IOR, inout Ray ray_out)
{
	vec3 ref_n = normal;
	float eta_t = IOR;
	float eta_i = 1.0f;
	float i_dot_n = dot(ray_dir_in, normal);

	if (i_dot_n < 0.0f) {
		i_dot_n = -i_dot_n;
	}
	else {
		//Inside the surface; invert the normal and swap the indices of refraction
		ref_n = -normal;
		eta_t = 1.0f;
		eta_i = IOR;
	}

	float eta = eta_i / eta_t;
	float k = 1.0f - (eta * eta) * (1.0f - i_dot_n * i_dot_n);
	if (k < 0.0f) {
		return false;
	}
	else {
		ray_out.Origin = intersection_point + (ref_n * -FLT_EPSILON);
		ray_out.Direction = normalize((ray_dir_in + i_dot_n * ref_n) * eta - ref_n * sqrt(k));
		return true;
	}
}


vec4 sampleDirectLight(HitInfo hitInfo, out vec3 lightDir, inout uint randomSeed) {

    // Pick a random hdri direction, weighted by luminance. High intensity directions are chosen more often
    int cdfIndex = binarySearchCDF(RandomValue(randomSeed));
    // Convert from chosen pixel index in hdri to uv coordinates
    vec2 hdriUV = vec2((cdfIndex % int(hdri_width)) / hdri_width, (cdfIndex / int(hdri_width)) / hdri_height); 
    
    lightDir = RotateSkyWorldDirInv(hdrPixelToWorldDirection(hdriUV));

    Ray sunTestRay;
    sunTestRay.Origin = hitInfo.position + lightDir * FLT_EPSILON * 10.0;
    sunTestRay.Direction = lightDir;

    HitInfo hitSun = IntersectRay(sunTestRay);
    bool sunVisible = hitSun.materialIndex < 0;

    // Check if light is visible (shadow ray)
    if (sunVisible) {
        float probability = cdfIndex == 0 ? hdri_cdf[0] :  hdri_cdf[cdfIndex] - hdri_cdf[cdfIndex - 1]; 
        return vec4(SampleHDRIFromDirection(lightDir).rgb, probability);
    } 

    return vec4(0.0); // No throughput if occluded
}


// ================================================================================================================
// ================================================================================================================
// ================================================================================================================
// ================================================================================================================

void main() {
    uint randomSeed = camdata.frameindex * uint(image_width * image_height) + gl_GlobalInvocationID.x;
    vec2 uv = vec2((gl_GlobalInvocationID.x % uint(image_width)) / image_width, (gl_GlobalInvocationID.x / image_width) / image_height); 
    vec2 uvCentered = uv * 2.f - 1.f;
    skyDir_cl = cos((2.0 * camdata.skyY - 1.0) * 2.0 * PI);
    skyDir_sl = sin((2.0 * camdata.skyY - 1.0) * 2.0 * PI);
    skyDirInv_cl = cos(-(2.0 * camdata.skyY - 1.0) * 2.0 * PI);
    skyDirInv_sl = sin(-(2.0 * camdata.skyY - 1.0) * 2.0 * PI);


    // Initial rays from camera with DoF
    Ray ray;
    // Defocus ray origin
	vec2 lookatJitter = RandomInCircle(randomSeed) * (32.0 / (2.0 * image_height));
    vec2 camJitter = RandomInCircle(randomSeed) * (camdata.dofStrength / max(image_width, image_height));
	ray.Origin = camdata.camPos.xyz + camdata.camRight.xyz * (camJitter.x + lookatJitter.x) + camdata.camUp.xyz * (camJitter.y  + lookatJitter.y);
	// Defocus at viewpoint, basically anti aliasing
	vec3 lookatVector = vec3(raydirs[gl_GlobalInvocationID.x * 3], raydirs[gl_GlobalInvocationID.x * 3 + 1], raydirs[gl_GlobalInvocationID.x * 3 + 2]);
	vec3 lookatPosition = lookatVector * camdata.dofDist + camdata.camPos.xyz + camdata.camRight.xyz * lookatJitter.x + camdata.camUp.xyz * lookatJitter.y;
	ray.Direction = normalize(lookatPosition - ray.Origin);


    
    vec3 accumulatedColor = vec3(0.0); 
    vec3 throughput = vec3(1.0);
    
    vec3 directLight = vec3(0.0);
    float pdfContribution = 1.0f;




    if (camdata.rendermode == 0){
        for (int i = 0; i < camdata.bounces; i++){
            // Do the actual ray test in the scene
            HitInfo hitInfo = IntersectRay(ray);

            // No hit
            if (hitInfo.materialIndex < 0){
                vec3 skyColor = SampleHDRIFromDirection(ray.Direction).rgb;
                accumulatedColor += throughput * skyColor;
                break;
            }

            // Get the actual material we hit
            Material mat = GetMaterial(hitInfo.materialIndex);   
            mat.Albedo = GetAlbedoColor(mat, hitInfo); // Get the color for this material, either diffuse texture lookup or material albedo

            // Alpha clipping, continue ray on other side (Alpha transparency in textures)
            // bool hitInside = dot(-ray.Direction, hitInfo.normal) < 0.0;
            if ( mat.Albedo.a < 0.9){
                ray.Origin = hitInfo.position + ray.Direction * FLT_EPSILON * 2.0;
                continue;
            }

            mat.Specular = GetSpecularColor(mat, hitInfo); // Get the specular color for this material, either specular texture or material Specularity
            mat.Roughness = max(1e-4, (1.0 - mat.Specular.r) * mat.Roughness);

            // Step 1: Accumulate emitted light first (Self-emission does not depend on throughput)
            accumulatedColor += mat.Emission.rgb * throughput;

            // Direct light
            vec3 lightDir;
            vec4 directLight = sampleDirectLight(hitInfo, lightDir, randomSeed);  

            // If the chosen direction actually saw the environment map (Not in shadow)
            if (directLight.w > 0.0){
                // Compute the cosine term between the surface normal and the sampled direction.
                float cosEnv = max(dot(hitInfo.normal, lightDir), 0.0);

                // Evaluate the BSDF for the direct light sample.
                vec3 brdfEval = evaluateBRDF(ray.Direction, hitInfo.normal, lightDir, mat);

                // Also, evaluate the BSDF's PDF for the same direction.
                float bsdfPdf = evaluateBSDFPdf(ray.Direction, hitInfo.normal, lightDir, mat);

                // Compute the MIS weight (using a balance heuristic).
                float misWeight =  (directLight.w + bsdfPdf + 1e-4);

                // Add the direct light contribution.
                accumulatedColor += throughput *  directLight.rgb * brdfEval * cosEnv / misWeight;
            }



            // Sample the BRDF to get the next ray direction.
            BRDFSample brdfSample = sampleBRDF(ray.Direction, hitInfo.normal, mat, randomSeed);
            float cosine = max(dot(brdfSample.direction, hitInfo.normal ), 0.0);

            // Update the throughput with the BRDF value, cosine term, and pdf.
            throughput *= brdfSample.value * cosine / brdfSample.pdf;

            // New ray origin offset from last hit position along surface normal
            ray.Origin = hitInfo.position + hitInfo.normal * FLT_EPSILON * 2.0;
            ray.Direction = brdfSample.direction;


            // Russian Roulette
            // As the throughput gets smaller, the ray is more likely to get terminated early.
            // Survivors have their value boosted to make up for fewer samples being in the average.     
            float p = max(throughput.r, max(throughput.g, throughput.b));
            if (RandomValue(randomSeed) > p)
                break;

            // Add the energy we 'lose' by randomly terminating paths
            throughput *= 1.0f / p;
        }
    }
    else{
        HitInfo hitInfo = IntersectRay(ray);

        // No hit
        if (hitInfo.materialIndex < 0){
            accumulatedColor = SampleHDRIFromDirection(ray.Direction).rgb;
        }
        else{
            // Get the color for this material, either diffuse texture lookup or material albedo
            Material mat = GetMaterial(hitInfo.materialIndex);
            accumulatedColor = GetAlbedoColor(mat, hitInfo).rgb;
        }
    }
    
    


    accumulatedColor = max(vec3(0.0), accumulatedColor);



    // Update accumulation buffer and output image
    vec4 oldColor = img_accu[gl_GlobalInvocationID.x];
    vec4 newColor = oldColor + ((vec4(accumulatedColor, 1.0) - oldColor) / camdata.frameindex); 
    img_accu[gl_GlobalInvocationID.x] = newColor;

    if (camdata.frameindex % 20 == 1)
    {
        // Color corrected image
        if (camdata.useACE == 1){
            accumulatedColor = LinearToSRGB(ACESFilm(camdata.exposure * newColor.rgb));
        }
        else{
            accumulatedColor = camdata.exposure * newColor.rgb;
        }

        img_out[gl_GlobalInvocationID.x] = vec4(accumulatedColor, 1.0);
    }
}